<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNaglowek"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:background="#1264F5"
            android:gravity="center"
            android:text="Planer treningów"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />


        <ImageView
            android:id="@+id/ivSportowiec"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:adjustViewBounds="true"
            android:contentDescription="Sportowiec"
            android:scaleType="centerCrop"
            android:src="@drawable/sportowiec" />


        <Button
            android:id="@+id/btnLosuj"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="18dp"
            android:backgroundTint="#1264F5"
            android:text="LOSUJ ĆWICZENIE"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />


        <ImageView
            android:id="@+id/ivCwiczenie"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="18dp"
            android:background="#F3F7FD"
            android:contentDescription="Aktualne ćwiczenie"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/cwiczenie0" />


        <TextView
            android:id="@+id/tvNazwaCwiczenia"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center"
            android:text="Losuj ćwiczenie"
            android:textColor="#101828"
            android:textSize="26sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMinus"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:backgroundTint="#C8D4E8"
                android:text="−"
                android:textColor="#101828"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSerie"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textColor="#101828"
                android:textSize="40sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPlus"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:backgroundTint="#C8D4E8"
                android:text="+"
                android:textColor="#101828"
                android:textSize="32sp"
                android:textStyle="bold" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNastepne"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:backgroundTint="#08AA5A"
                android:text="NASTĘPNE\nĆWICZENIE"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:backgroundTint="#F3212F"
                android:text="RESET"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <TextView
            android:id="@+id/tvLacznaLiczba"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="12dp"
            android:background="#EEF4FD"
            android:gravity="center"
            android:text="Łączna liczba serii: 0"
            android:textColor="#101828"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
